# Copy to .env and fill in values. Never commit the real .env file.
TZ=Asia/Shanghai
PUID=1000
PGID=1000

# Create a bot with @BotFather
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
# Telegram numeric user IDs, comma-separated. Only these users can operate the bot.
TELEGRAM_ALLOWED_USER_IDS=REPLACE_WITH_YOUR_NUMERIC_TELEGRAM_USER_ID

# qBittorrent WebUI/API. Use an address reachable from the bot container.
# If qBittorrent is in another Docker Compose project, use the LXC LAN IP + published WebUI port,
# or attach both stacks to a shared external Docker network and use the qBittorrent container name.
QBIT_BASE_URL=http://REPLACE_WITH_LXC_LAN_IP:8080
QBIT_USERNAME=REPLACE_WITH_QBIT_USERNAME
QBIT_PASSWORD=REPLACE_WITH_QBIT_PASSWORD
QBIT_CATEGORY=telegram-bot

# Jackett is internal to this Compose network. Get API key from Jackett dashboard.
JACKETT_API_KEY=REPLACE_WITH_JACKETT_API_KEY
JACKETT_WEBUI_PORT=9117

# Keep this Compose project directory on the LXC system disk. These relative paths
# then keep Jackett/Bot configuration and state on the system disk as well.
# They are NOT your media/download destination; qBittorrent keeps using its existing
# download path, which should already map to the HDD-backed /data/media directory.
# Optional paths (relative paths are relative to this directory)
JACKETT_CONFIG_PATH=./data/jackett
JACKETT_DOWNLOADS_PATH=./data/jackett-downloads
BOT_DATA_PATH=./data/bot

SEARCH_LIMIT=10
POLL_INTERVAL_SECONDS=60
